{
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Robots-Tag": "noindex, nofollow"
  },
  "routes": [
    {
      "route": "/",
      "redirect": "https://www.ians.no/",
      "statusCode": 301
    },
    {
      "route": "/index.html",
      "redirect": "https://www.ians.no/",
      "statusCode": 301
    },
    {
      "route": "/teknisk*",
      "redirect": "https://www.ians.no/teknisk.html",
      "statusCode": 301
    },
    {
      "route": "/admin*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/axion-grid/admin*",
      "allowedRoles": [
        "AxionAdmin",
        "axionadmin",
        "AxionOwner",
        "axionowner"
      ]
    },
    {
      "route": "/axion-grid/customer*",
      "allowedRoles": [
        "AxionReader",
        "axionreader",
        "AxionUser",
        "axionuser",
        "AxionCustomer",
        "axioncustomer",
        "AxionAdmin",
        "axionadmin",
        "AxionOwner",
        "axionowner"
      ]
    },
    {
      "route": "/api/azure-cost*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/axion-advisor*",
      "allowedRoles": [
        "AxionReader",
        "axionreader",
        "AxionUser",
        "axionuser",
        "AxionCustomer",
        "axioncustomer",
        "AxionAdmin",
        "axionadmin",
        "AxionOwner",
        "axionowner"
      ]
    },
    {
      "route": "/api/axion-proposal-send*",
      "allowedRoles": [
        "AxionReader",
        "axionreader",
        "AxionUser",
        "axionuser",
        "AxionCustomer",
        "axioncustomer",
        "AxionAdmin",
        "axionadmin",
        "AxionOwner",
        "axionowner"
      ]
    },
    {
      "route": "/api/contact",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/axion-grid/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/axion-grid",
      "redirect": "/axion-grid/",
      "statusCode": 301
    },
    {
      "route": "/*",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/retired.html"
    }
  }
}
